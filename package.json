{
  "name": "@hexapi/design",
  "version": "1.0.2",
  "description": "HexaPi design tokens, theme files, component styles, React components and shared preferences for every HexaPi app",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./tokens.json": "./dist/tokens.json",
    "./prefs": {
      "types": "./dist/prefs.d.ts",
      "default": "./dist/prefs.js"
    },
    "./components.css": "./dist/components.css",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning scripts/build.mjs",
    "test": "node --test scripts/*.test.mjs",
    "check": "npm run build && npm test && git diff --exit-code -- dist",
    "format": "prettier --write src scripts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
